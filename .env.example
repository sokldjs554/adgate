# 인증 토큰(필수). 형식: token:role:identity (role = advertiser | advertiser+verified | reviewer)
# advertiser+verified 는 플랫폼이 사업자 인증을 마친 광고주다. 소재가 스스로 적은 verified 는 이 값을 넘지 못한다.
ADGATE_TOKENS=change-me-adv:advertiser:alice,change-me-rev:reviewer:bob
# 데모용 공개 토큰(dev-advertiser, dev-advertiser-2, dev-reviewer)을 켠다. 운영에서는 켜지 않는다.
# ADGATE_TOKENS 와 함께 쓸 수 없고, 루프백이 아닌 주소에서는 ADGATE_DEV_ALLOW_PUBLIC=1 이 있어야 시작한다.
# ADGATE_DEV=1
ADGATE_DB=var/adgate.sqlite3
ADGATE_RATE_PER_MIN=120

# 참고: `adgate serve` 는 LLM judge 를 쓰지 않는다(Settings 가 judge 를 만들지 않는다). judge 는 `adgate judge-check`·`judge-record`·`eval --judge anthropic`
# 에서만 쓰며 ANTHROPIC_API_KEY 가 필요하다(docs/JUDGE_LIVE.md). 키는 환경 변수나 Actions secret 으로만 넣고 파일·채팅·커밋에 적지 않는다.
# ANTHROPIC_API_KEY=
# ADGATE_JUDGE_MODEL=claude-opus-5-5
