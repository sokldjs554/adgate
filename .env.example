# 인증 토큰(필수). 형식: token:role:identity (role = advertiser | reviewer)
ADGATE_TOKENS=change-me-adv:advertiser:alice,change-me-rev:reviewer:bob
# 데모용 공개 토큰(dev-advertiser, dev-advertiser-2, dev-reviewer)을 켠다. 운영에서는 켜지 않는다.
# ADGATE_DEV=1
ADGATE_DB=var/adgate.sqlite3
ADGATE_RATE_PER_MIN=120

# 선택: LLM judge (키가 있어야 한다. 실호출은 이 저장소에서 측정하지 않았다)
# ANTHROPIC_API_KEY=
# ADGATE_JUDGE_MODEL=claude-opus-5-5
